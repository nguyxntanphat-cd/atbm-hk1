# node server.js tự nạp .env. Không commit file chứa bí mật.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Mật khẩu mẫu chỉ dành cho demo local.
EMPLOYEE_PASSWORD=123456
BOSS_PASSWORD=admin123
BOSS_PASS=boss123
ADMIN_PASSWORD=quantri123
# MySQL của XAMPP trên máy này dùng cổng 3307 (xem mysql/bin/my.ini).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=atbm_internal
STORAGE_QUOTA_MB=1024
# Tuỳ chọn demo; bắt buộc khi NODE_ENV=production. Quy ước ClamAV: exit 0 sạch, 1 nhiễm.
# SCANNER_COMMAND=C:/Program Files/ClamAV/clamscan.exe
# SCANNER_ARGS=["--no-summary"]
# Production: mật khẩu riêng >= 12 ký tự và cung cấp TLS.
# TLS_KEY=certs/server-key.pem
# TLS_CERT=certs/server-cert.pem
